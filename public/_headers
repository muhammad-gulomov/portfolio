# Long-lived caching for fingerprinted / stable assets.
#
# CSS and JS are cache-busted with ?v=<BUILD> from Layout.tsx, and the query
# string is part of the browser's cache key, so a bumped BUILD is a new URL.
# Images are versioned the same way, through photo_path in the database.
# Fonts carry no version param — replace them by filename if they ever change.
#
# The rule: nothing under these paths may be edited in place without also
# changing the URL that points at it, or cached clients keep the old bytes.
#
# Default for these paths was `max-age=0, must-revalidate`, which cost a
# revalidation round-trip on every repeat visit.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/img/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable
